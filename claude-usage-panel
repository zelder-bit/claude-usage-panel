#!/usr/bin/env python3
"""xfce4-genmon script: Claude 5-hour and weekly usage. Run with --selftest to check formatting."""
import json, sys, time, urllib.request
from datetime import datetime, timezone
from pathlib import Path

CREDS = Path.home() / ".claude/.credentials.json"
CACHE = Path.home() / ".cache/claude-usage-panel.json"
MIN_GAP, BACKOFF = 300, 900  # seconds between API calls; wait after a failure
URL = "https://api.anthropic.com/api/oauth/usage"  # same endpoint Claude Code's /usage reads


def until(iso):
    if not iso:
        return "?"
    secs = (datetime.fromisoformat(iso.replace("Z", "+00:00")) - datetime.now(timezone.utc)).total_seconds()
    h, m = divmod(max(0, int(secs)) // 60, 60)
    return f"{h // 24}d {h % 24}h" if h >= 24 else f"{h}h {m}m"


def color(pct):
    return "#e06c75" if pct >= 90 else "#e5c07b" if pct >= 70 else "#98c379"


def render(data, note=""):
    five, week = data.get("five_hour") or {}, data.get("seven_day") or {}
    p5, p7 = five.get("utilization") or 0, week.get("utilization") or 0
    txt = (f"<txt>5h <span fgcolor='{color(p5)}'>{p5:.0f}%</span>  "
           f"wk <span fgcolor='{color(p7)}'>{p7:.0f}%</span></txt>")
    tool = (f"<tool>Claude usage\n5-hour: {p5:.0f}% (resets in {until(five.get('resets_at'))})\n"
            f"Weekly: {p7:.0f}% (resets in {until(week.get('resets_at'))})\n{note}</tool>")
    return txt + tool + "<txtclick>xdg-open https://claude.ai/settings/usage</txtclick>"


def fetch():
    token = json.loads(CREDS.read_text())["claudeAiOauth"]["accessToken"]
    req = urllib.request.Request(URL, headers={
        "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def main(now=None):
    # The API rate-limits hard, so call it at most every MIN_GAP seconds whatever genmon's period is,
    # back off on errors, and keep showing the last good numbers meanwhile.
    now = now or time.time()
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    if now >= cache.get("next", 0):
        try:
            cache = {"data": fetch(), "fetched": now, "next": now + MIN_GAP}
        except Exception as e:  # shortcut: no token refresh; an expired token shows until Claude Code next refreshes it
            retry = getattr(e, "headers", None) and e.headers.get("Retry-After")
            cache.update(error=str(e), next=now + max(BACKOFF, int(retry) if str(retry).isdigit() else 0))
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps(cache))
    if "data" not in cache:
        return f"<txt>Claude ?</txt><tool>Claude usage unavailable: {cache.get('error')}</tool>"
    note = f"Updated {int(now - cache['fetched']) // 60} min ago"
    if cache.get("next", 0) - cache["fetched"] > MIN_GAP:  # last attempt failed
        note += f"; last refresh failed: {cache.get('error')}"
    return render(cache["data"], note)


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        out = render({"five_hour": {"utilization": 95, "resets_at": "2099-01-01T00:00:00Z"},
                      "seven_day": {"utilization": 42.4, "resets_at": None}})
        assert "95%" in out and "#e06c75" in out and "42%" in out and "#98c379" in out, out
        assert render({})  # missing fields don't crash
        import tempfile
        CACHE = Path(tempfile.mkdtemp()) / "c.json"
        calls = []
        def fetch():
            calls.append(1)
            if len(calls) > 1:
                raise OSError("429")
            return {"five_hour": {"utilization": 62}}
        assert "62%" in main(1000) and len(calls) == 1
        assert "62%" in main(1100) and len(calls) == 1  # within MIN_GAP: served from cache
        out = main(1400)  # refresh fails: old numbers stay, error in tooltip
        assert "62%" in out and "failed: 429" in out and len(calls) == 2, out
        main(1400 + BACKOFF - 1)
        assert len(calls) == 2  # still backing off
        print("ok")
    else:
        print(main())
